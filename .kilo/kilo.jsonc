{
  "$schema": "https://app.kilo.ai/config.json",
  // Ponytail (DietrichGebert/ponytail, MIT, v5.3.2): lazy senior dev mode.
  // Active for code-editing tasks only; NOT for research/testing/model tasks.
  // Enable per-session with /ponytail full; default mode is off.
  "plugin": ["@dietrichgebert/ponytail"],
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": {
      "*": "ask",
      "docs/PROJECT_PLAN.md": "allow",
      "docs/agent-improvement/*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "ask",
      "ffprobe *": "allow",
      "git diff --cached --name-only": "allow",
      "stat *": "allow",
      "git diff --cached": "allow",
      "git status": "allow",
      "git log --oneline *": "allow",
      "git diff": "allow"
    },
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "task": "ask",
    "lsp": "deny",
    "skill": "ask"
  }
}

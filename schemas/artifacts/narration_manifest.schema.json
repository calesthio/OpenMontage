{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/narration_manifest",
  "title": "Narration Manifest",
  "description": "Stage 7 output of the business-documentary pipeline. Records the real synthesized audio, its measured duration, the exact text that was synthesized and the timestamps captions are built from. Duration is taken from the audio file, never from a words-per-minute estimate.",
  "type": "object",
  "required": ["version", "run_id", "created_at", "provider", "model", "voice_id", "language", "input_text_sha256", "segments", "total_duration_seconds"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "Synthesizer that actually ran, e.g. 'piper'. 'none' is only valid when the film is intentionally silent."
    },
    "model": { "type": "string", "minLength": 1 },
    "voice_id": { "type": "string", "minLength": 1 },
    "voice_license": {
      "type": "string",
      "description": "License and permitted use of the voice model. Required before commercial publication."
    },
    "language": { "type": "string", "const": "en-US" },
    "input_text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the exact narration text that was synthesized."
    },
    "script_ref": {
      "type": "string",
      "description": "Path or artifact reference of the script the narration came from."
    },
    "total_duration_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Measured from the audio files, not estimated."
    },
    "sample_rate_hz": { "type": "integer", "minimum": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "script_section", "text", "audio_path", "start_seconds", "end_seconds", "duration_seconds"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "script_section": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "audio_path": { "type": "string", "minLength": 1 },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "word_timestamps": {
            "type": "array",
            "description": "Word or phrase level timestamps used to build captions.",
            "items": {
              "type": "object",
              "required": ["word", "start_seconds", "end_seconds"],
              "properties": {
                "word": { "type": "string" },
                "start_seconds": { "type": "number", "minimum": 0 },
                "end_seconds": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "pronunciation_notes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Brand, acronym, number and unit pronunciation hints applied to this segment."
          },
          "text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "description": "How the synthesized audio was checked back against the intended text.",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["local_stt_transcript", "provider_timestamps", "manual_listen", "none"]
        },
        "word_accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed": { "type": ["boolean", "null"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": {
      "*": "ask",
      "docs/PROJECT_PLAN.md": "allow",
      "docs/agent-improvement/*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "ask",
      "ffprobe *": "allow",
      "git diff --cached --name-only": "allow",
      "stat *": "allow",
      "git diff --cached": "allow",
      "git status": "allow",
      "git log --oneline *": "allow",
      "git diff": "allow"
    },
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "task": "ask",
    "lsp": "deny",
    "skill": "ask"
  }
}
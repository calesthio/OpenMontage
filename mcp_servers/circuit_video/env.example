# Copy values into the shell or OpenMontage/.env — never commit real keys.
# AWS access/secret live in circuit-kubernetes/tmp/secret.yml under "## bAWS s3".
# Do not point the MCP at that file: it also contains GitHub tokens and VPN passwords.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# Existing Circuit bucket; objects land under this prefix.
CIRCUIT_VIDEO_S3_BUCKET=circuit-kubernetes
CIRCUIT_VIDEO_S3_PREFIX=openmontage/tutorials/
CIRCUIT_VIDEO_S3_REGION=eu-central-1
# Optional CloudFront/public base. When unset, upload returns a 24h presigned GET URL.
# CIRCUIT_VIDEO_S3_PUBLIC_BASE=https://cdn.example.com

# Optional: k8s render-api instead of a local Cypress render.
# CIRCUIT_VIDEO_RENDER_API_URL=http://tutorials.example.com

# Overrides (else tutorial.config.json / defaults).
# TUTORIAL_CLIENT_DIR=/media/bl/Disk2/htdocs/circuitauction-backoffice/client
# TUTORIAL_BASE_URL=https://backoffice.ddev.site:9010
# TUTORIAL_NARRATION_URL=http://127.0.0.1:5557
# TUTORIAL_RENDER_RUNTIME=ffmpeg

# Narration backend: "ttsd" (default; sidecar at TUTORIAL_NARRATION_URL) or
# "elevenlabs" (direct API, no Docker). The ElevenLabs keys below are only read
# for the elevenlabs backend; ttsd gets them via `tutorialctl up`.
# TUTORIAL_NARRATION_BACKEND=elevenlabs
# TUTORIAL_VOICE_ID=            # optional single-voice override (else per-lang map)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_IDS=en:<voice_id>,fr:<voice_id>
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TUTORIAL_NARRATION_CACHE_DIR=.cache/narration/elevenlabs

    "@remotion/player": "^4.0.484",
    "@remotion/transitions": "^4.0.484",
    "d3-geo": "^3.1.1",
    "fast-uri": "^3.1.5",
    "gsap": "3.14.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.484",
    "three": "0.181.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.3.0"
  },

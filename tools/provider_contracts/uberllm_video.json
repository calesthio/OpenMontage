{
  "_about": {
    "provider": "uberllm",
    "base_url": "https://api.uberllm.dev",
    "auth_header": "Authorization: Bearer <UBERLLM_API_KEY>",
    "docs": "https://uberllm.dev/docs/media",
    "models_list": "GET /v1/models?type=video (public)",
    "model_schema": "GET /v1/models/{model_id} (public; parameters is the request JSON Schema)",
    "submit": "POST /v1/video/generations (Idempotency-Key header)",
    "poll": "GET /v1/video/generations/{id} (202 while running, 200 once ended)",
    "cancel": "DELETE /v1/video/generations/{id}",
    "content": "GET /v1/media/artifacts/{id}/{index} (same key; kept about 3 hours)",
    "upload": "POST /v1/files (multipart file; kept 24 hours, usable as image_url)",
    "quote": "same body as submit with validate: true (free, nothing made or charged)",
    "balance": "GET /v1/balance",
    "job_statuses": [
      "queued",
      "running",
      "succeeded",
      "failed",
      "canceled",
      "expired"
    ],
    "billing": "failed, canceled and expired jobs cost nothing; a finished job is billed what the provider charged, never more than max_cost_usd (what is held when it starts); estimated_cost_usd is the listed price",
    "pricing_note": "usd_per_second is the highest listed rate the free validate quote returned for each resolution (any audio setting), per clip second, so preflight estimates do not undercount; dry_run returns the exact quote. Regenerate from GET /v1/models/{model_id} and validate quotes when models change.",
    "verified_on": "2026-11-10"
  },

  "text-to-video": {
    "api_id": "pika/pika-h3-flex/text-to-video",
    "call": {
      "method": "POST",
      "path": "/v1/media/pika/pika-h3-flex/text-to-video"
    },
    "description": "Pika H3 Flex Text to Video: generate a 3 to 15 second video with synchronized audio from a text prompt, at 480p or 768p, or upscaled to 1080p, 2K or 4K. Billed per output second.",
    "input_schema": {
      "additionalProperties": false,
      "native_audio": true,
      "properties": {
        "prompt": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "duration": {
          "default": 5,
          "description": "Requested video duration in whole seconds, from 3 to 15. Native output rounds up to the model's frame grid and may be slightly longer.",
          "maximum": 15,
          "minimum": 3,
          "title": "Duration",
          "type": "integer"
        },
        "aspect_ratio": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "21:9",
                "16:9",
                "3:2",
                "4:3",
                "5:4",
                "1:1",
                "4:5",
                "3:4",
                "2:3",
                "9:16",
                "9:21"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Output aspect ratio. Auto selects from the original prompt and reference video, even when rewrite is false; with a keyframe it follows the first supplied keyframe. A fixed ratio always wins. When omitted, rewriting enables Auto; without rewriting, the first supplied keyframe sets the ratio, or 16:9 without a keyframe. Keyframes are resized and center-cropped to fit.",
          "title": "Aspect Ratio"
        },
        "resolution": {
          "default": "768p",
          "description": "480p/768p are native. 1080p/2k/4k generates at 768p, then upscales once with the V1 model, preserving audio and frame rate.",
          "enum": [
            "480p",
            "768p",
            "1080p",
            "2k",
            "4k"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "rewrite": {
          "default": true,
          "description": "Improve the prompt before generation; disable to use the original prompt.",
          "title": "Rewrite",
          "type": "boolean"
        },
        "output_mode": {
          "default": "video",
          "description": "audio-stems (Flex in production, every H3 family in staging) returns the original video with audio plus Dialogue, Music and Effect WAV files. Uses standard retention and adds the catalog's separation fee. Flex bills the sum of all decoded output-stem durations, without a channel multiplier. The default returns only the video.",
          "enum": [
            "video",
            "audio-stems"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "channel_mode": {
          "default": "mono",
          "description": "Audio stems only: mono (default) downmixes before separation; explicit stereo preserves both channels. The video's audio is unchanged.",
          "enum": [
            "stereo",
            "mono"
          ],
          "title": "Channel Mode",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "PikaH3FlexRequest",
      "type": "object"
    },

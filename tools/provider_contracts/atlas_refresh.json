  "openai/gpt-image-2.5-flare/text-to-image": {
    "input_schema": {
      "type": "object",
      "required": [
        "model",
        "prompt"
      ],
      "properties": {
        "model": {
          "type": "string",
          "description": "Model name.",
          "default": "openai/gpt-image-2.5-flare/text-to-image",
          "enum": [
            "openai/gpt-image-2.5-flare/text-to-image"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 32000,
          "default": "A neon-lit ramen stall on a rainy Tokyo street, cinematic wide shot.",
          "description": "Text description of the desired image. Up to 32000 characters."
        },
        "quality": {
          "type": "string",
          "default": "medium",
          "enum": [
            "auto",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Rendering quality tier. gpt-image-2.5 adds xhigh and max on top of low/medium/high. Higher tiers cost more per image.",
          "x-ui-component": "select"
        },
        "size": {
          "default": "1024x1024",
          "description": "optional string or auto or 1024x1024 or 1536x1024 or 5 moreThe size ofthe generated images.For gpt-image-2.5 is supported as WIDTHxHEIGHT strings,for example 1536x864 . Width and height mustboth be divisible by 16 and the requested aspect ratio must be between 1:3 and 3:1.Resolutions above2560x1440 are experimental, and the maximum supported resolution is 3840x2160 .The requesteosize must also satisfy the model's current pixel and edge limits.The standard sizes 1024x1024.1536x1024 ,and 1024x1536 are supported by the GPT image models; auto is supported for modelsthat allow automatic sizing.For dall-e-2,use oneof 256x256,512x512,or 1024x1024.Fordall-e-3,use oneof 1024x1024,1792x1024,or 1024x1792.",
          "enum": [
            "auto",
            "1024x1024",
            "1024x768",
            "768x1024",
            "1024x1280",
            "1024x1536",
            "1536x1024",
            "2048x2048",
            "2048x1152",
            "1152x2048",
            "2560x1088",
            "1088x2560",
            "2880x2160",
            "2160x2880",
            "3840x2160",
            "2160x3840"
          ],
          "type": "string"
        },
        "background": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "opaque",
            "transparent"
          ],
          "description": "Background of the generated image. When using transparent, set the output format to png or webp.",
          "x-ui-component": "select"
        },
        "output_format": {
          "type": "string",
          "default": "png",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ],
          "description": "Output image format.",
          "x-ui-component": "select"
        },
        "moderation": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "low"
          ],
          "description": "Content-moderation strictness. low applies less restrictive filtering.",
          "x-ui-component": "select"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1,
          "description": "Number of images to generate, 1 to 10. Each image is billed separately."
        }
      },
      "x-order-properties": [
        "model",
        "prompt",
        "quality",
        "size",
        "background",
        "output_format",
        "n"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "background": {
                "const": "transparent"
              }
            },
            "required": [
              "background"
            ]
          },
          "then": {
            "properties": {
              "output_format": {
                "enum": [
                  "png",
                  "webp"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "source": "https://www.atlascloud.ai/models/openai/gpt-image-2.5-flare/text-to-image",
    "verified_on": "2026-10-03"
  },
